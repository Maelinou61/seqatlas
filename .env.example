# Chemin vers la base MMseqs déjà créée
MMSEQS_DB=/chemin/vers/ta/base_mmseqs

# Optionnel: binaire mmseqs si non présent dans le PATH
MMSEQS_BIN=mmseqs

# Optionnel: nombre de threads pour mmseqs
MMSEQS_THREADS=8

# Optionnel: arguments supplémentaires mmseqs
MMSEQS_EXTRA_ARGS=

# Configuration VIRE (profil par défaut)
# Les anciennes variables POSTPROCESS_SCRIPT et METADATA_FILE restent compatibles.
POSTPROCESS_SCRIPT=scripts/add_metadata/add_metadata_mmseqs2.py
METADATA_FILE=/chemin/vers/vire_with_coordinates.parquet
VIRE_POSTPROCESS_SCRIPT=scripts/add_metadata/add_metadata_mmseqs2.py
VIRE_METADATA_FILE=/chemin/vers/vire_with_coordinates.parquet

# Configuration MetaVR. Le script MetaVR utilise obligatoirement ces deux tables:
# --metadata pour les métadonnées IMG et --taxonomy pour IMGVR5_UViG.
METAVR_POSTPROCESS_SCRIPT=scripts/add_metadata/add_metadata_genomes_metavr.py
METAVR_METADATA_FILE=/chemin/vers/Source_dataset_metadata.tsv
METAVR_TAXONOMY_FILE=/chemin/vers/IMGVR5_UViG.tsv

# Une base dont le nom contient "metavr" ou "imgvr" utilise MetaVR.
# Pour une base au nom différent, liste son nom (ou chemin) ici, séparé par des virgules.
METAVR_DATABASES=
# Optionnel: motifs de détection supplémentaires, séparés par des virgules.
METAVR_DATABASE_PATTERNS=metavr,imgvr

# Optionnel
PORT=8000
